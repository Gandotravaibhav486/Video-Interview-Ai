# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# local question-bank review exports (operator's own verification, not shipped)
/question-bank-export/

# operator's own cost/revenue working notes. Ignored rather than sanitised:
# a redacted file is still readable in git history, so these must never land
# in a commit in the first place.
/financial-analysis.md
/operating-cost-analysis.md

# R console history, dropped into docs/ by an editor session
.Rhistory

# per-machine agent settings. The vendored skills in .agents/ (and the
# .claude/skills symlink into them) ARE committed on purpose - this only
# excludes the local, machine-specific permission file.
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
